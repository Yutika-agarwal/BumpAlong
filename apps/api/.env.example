PORT=3000
# Postgres with PostGIS. Not used yet: the API runs on the in-memory store until the Postgres store lands.
DATABASE_URL=postgres://bumpalong:bumpalong@localhost:5432/bumpalong
# Amazon Associates. Leave the tag empty to turn links off.
AMAZON_ASSOCIATE_TAG=
# Optional tracking ID per placement, e.g. AMAZON_TAG_LOST_DRAW=bumpalong-lost-20
AMAZON_TAG_REPLACEMENT_PARTS=
AMAZON_TAG_BUY_NEW=
AMAZON_TAG_LOST_DRAW=
AMAZON_TAG_UNMATCHED_REQUEST=
# Add ios,android only after Amazon approves the app.
AFFILIATE_PLATFORMS=web
